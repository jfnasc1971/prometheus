#!/bin/bash
clear

export JAVA_HOME=/c/caixa/opt/jdk1.8.0_461
export JAVA_TOOL_OPTIONS="-Dfile.encoding=UTF-8"

BUILD_FILE="prometheus-core/src/main/resources/build.properties"

ant

if [ "$1" == commit ];then

  echo "Commit...."

  if [ -n "$(git ls-files --others --exclude-standard)" ];then
    for f in $(git ls-files --others --exclude-standard);do
      git add "$f"
    done
  fi

  if [ -n "$(git status --porcelain)" ];then
    git commit -a -m "STRY00077013: SIGCT - Memória de cálculo dos contratos 8663/2018, 8664/2018 e 8718/2023"
  fi

  git push

  LABEL="$(cat $BUILD_FILE |grep -e 'version'|awk -F '=' '{print $2}').$(cat $BUILD_FILE |grep -e 'build.number'|awk -F '=' '{print $2}')"
  echo $LABEL

  # existe?
  if [ -z '$(git ls-remote --tags | grep "v$LABEL")' ];then
    git tag -d v$LABEL
    git push origin :refs/tags/v$LABEL
  fi

  git tag -a v$LABEL -m "Versão $LABEL"
  git push -u origin v$LABEL 

fi

cp prometheus-core/target/prometheus.jar /projetos/prometheus/dist/
cp prometheus-core/target/prometheus.jar /projetos/caixa/sigct/sustentacao/Memorias_Calculo/
cd /projetos/caixa/sigct/sustentacao/planilhas/
git commit -a -m "STRY00077013: SIGCT - Memória de cálculo dos contratos 8663/2018, 8664/2018 e 8718/2023"
git push

