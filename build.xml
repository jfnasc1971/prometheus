<?xml version="1.0"?>
<project name="prometheus" default="package">

  <property file="build.properties" />

	<target name="init" depends="update-build-number">
		<mkdir dir="${build.dir}/${app.version}.${build.number}" />
	</target>

	<target name="update-revision">
		<exec executable="/bin/bash" outputproperty="revision.number" failonerror="true">
			<arg value="-c" />
			<arg value="git log --format='%H' -n 1" />
		</exec>
		
		<echo>Commit ID: ${revision.number}</echo>

		<exec executable="/bin/bash" failonerror="true" encoding="ISO-8859-1">
			<arg value="-c" />
			<arg value="git log -1 > ${basedir}/prometheus-core/src/main/resources/repoinfo.properties" />
		</exec>
	</target>

	<target name="package" depends="init">
		<exec executable="/bin/bash" failonerror="true">
			<arg value="-c" />
			<arg value="mvn -DskipTests -Dapp.version=${app.version} clean install" />
		</exec>
		<copy file="${basedir}/prometheus-core/target/prometheus.jar" tofile="${dist.dir}/prometheus.jar" />
	</target>

	<target name="update-build-number" depends="update-revision">
		<buildnumber file="build.number"/>
		<echo>Build Number: ${build.number}</echo>

		<propertyfile file="${basedir}/prometheus-core/src/main/resources/build.properties" encoding="ISO-8859-1">
			<entry key="build.date" type="date" value="now" />
			<entry key="revision.number" value="${revision.number}" />
			<entry key="build.number" value="${build.number}" />
			<entry key="nomeSistema" value="${app.name}" />
			<entry key="version" value="${app.version}" />
		</propertyfile>

	</target>
</project>
