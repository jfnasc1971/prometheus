<?xml version="1.0" encoding="UTF-8"?>
<project name="Prometheus" default="package" basedir=".">

  <!-- Detecta o sistema operacional -->
  <condition property="is.windows">
    <os family="windows" />
  </condition>

  <condition property="is.linux">
    <os family="unix" />
  </condition>

  <!-- Define qual arquivo de build incluir -->
  <condition property="build.file" value="build.win.xml" else="build.linux.xml">
    <isset property="is.windows" />
  </condition>

  <!-- Importa o build apropriado -->
  <import file="${build.file}" />

  <!-- Target principal -->
  <target name="package" depends="package-platform">
    <echo message="Executando target package do Prometheus (${os.name})" />
  </target>

</project>
