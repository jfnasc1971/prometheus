<?xml version="1.0"?>
<project name="prometheus" default="package" basedir=".">

  <property file="build.properties" />
  <condition property="mvn.executable" value="mvn.cmd" else="mvn">
    <os family="windows" />
  </condition>

	<target name="init" depends="update-build-number">

	</target>

	<target name="update-revision">
		<exec executable="git" outputproperty="revision.number" failonerror="true">
			<arg value="log" />
			<arg value="--format=%H" />
			<arg value="-n" />
			<arg value="1" />
		</exec>

		<exec executable="git" outputproperty="repo.info" failonerror="true">
			<arg value="log" />
			<arg value="-1" />
		</exec>
		
		<echo>Commit ID: ${revision.number}</echo>

		<echo file="${basedir}/prometheus-core/src/main/resources/repoinfo.properties" encoding="ISO-8859-1">${repo.info}</echo>
	</target>

	<target name="package" depends="init">
		<exec executable="${mvn.executable}" failonerror="true">
			<arg value="-DskipTests" />
			<arg value="-Dapp.version=${app.version}" />
			<arg value="clean" />
			<arg value="install" />
		</exec>
		<copy file="${basedir}/prometheus-core/target/prometheus.jar" tofile="${dist.dir}/prometheus.jar" />
	</target>

	<target name="update-build-number" depends="update-revision">
		<buildnumber file="build.number"/>
		<echo>Build Number: ${build.number}</echo>

		<propertyfile file="${basedir}/prometheus-core/src/main/resources/build.properties">
			<entry key="build.date" type="date" value="now" />
			<entry key="revision.number" value="${revision.number}" />
			<entry key="build.number" value="${build.number}" />
			<entry key="nomeSistema" value="${app.name}" />
			<entry key="version" value="${app.version}" />
		</propertyfile>

	</target>
</project>
