#!/bin/bash
pwd="$(pwd)"

STARTTIME="$(date +%s%N)"

if [ -z "$1" ];then
  echo "Informe o nome do script."
  exit
fi

sed -i 's/{ts//gi' $1
sed -i 's/{d//gi' $1
sed -i 's/}//gi' $1

filename="$(echo "$1" | awk -F '/' '{print $NF}')";
logdir="$(echo "$1" | sed -e "s|${filename}||gi")logs";
if [ ! -d $logdir ];then
  mkdir -p "$logdir"
fi
logfile="${logdir}/${filename}.messages"

export PGPASSWORD="postgres" 
#psql -h localhost -U postgres gctdes01 <$1 2>&1 | tee $logfile
#psql -h localhost -U postgres gctdes02 < $1 2>&1 | tee $logfile
#psql -h localhost -U postgres gctprd01 < $1 2>&1 | tee $logfile

#psql -h sigct.fabrica -U postgres gcttqs01 < $1 2>&1 | tee $logfile
psql -h sigct.fabrica -U postgres gctprd01 < $1 2>&1 | tee $logfile

# Ambientes CAIXA
export PGPASSWORD="gct"

# sctdeapllx0017.df.caixa
#psql -h sctdedadlx0015.df.caixa -p 5432 -U gct sigcttqs< $1 2>&1 | tee $logfile

# sctdeapllx0018.df.caixa
#psql -h sctdedadlx0012.df.caixa -p 5432 -U gct sigctdes< $1 2>&1 | tee $logfile

#
export PGPASSWORD="gcdv"
#psql -h 10.55.1.11 -p 5432 -U gcdv posprd01< $1 2>&1 | tee $logfile 

echo -e "\n-------------------------------------------------------"
echo "-- Resultados"
echo "-------------------------------------------------------"

op="$(cat ${logfile} | grep -i "Error")"

if [ -z "$op" ];then
  echo "Log: ${logfile}" 
  echo "Tudo certo :)";
else
  echo "Log: ${logfile}" 
  echo "ERRO:";
  echo "$op";
fi;

echo "-------------------------------------------------------"

ENDTIME="$(date +%s%N)"
echo ""
echo "Time: $(perl -e "print ((${ENDTIME} - ${STARTTIME}) / 1000000000)") seconds"
echo ""
exit
