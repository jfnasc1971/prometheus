	public IndicadorDTO findByFatura(String coEquipe, Long nuFatura, boolean isRepactuacao) {
		
		IndicadorDTO result = null;

		Connection conn = null;
		PreparedStatement pstmt = null;
		ResultSet rs = null;

		try {

			conn = databaseService.getDataSource().getConnection();

			pstmt = conn.prepareStatement(getIndicadorDML(isRepactuacao));
			pstmt.setString(1, coEquipe);
			pstmt.setLong(2, nuFatura);
			if (isRepactuacao) {
				pstmt.setLong(3, nuFatura);	
			}

			rs = pstmt.executeQuery();

			if (rs.next()) {

				result = new IndicadorDTO();

				result.setNuTipoIndicador(rs.getLong("nu_tipo_indicador"));
				result.setNoTipoIndicador(rs.getString("no_tipo_indicador"));
				result.setSgTipoIndicador(rs.getString("sg_tipo_indicador"));
				result.setDhGeracaoIndicadorEquipe(rs.getDate("dh_geracao_indicador_equipe"));
				result.setVrCalculoIndicador(rs.getBigDecimal("vr_calculo_indicador"));
				result.setVrFaixaFns(rs.getBigDecimal("vr_faixa_fns"));

			}
		} catch (SQLException e) {
			e.printStackTrace();
		} finally {
			DBUtil.close(conn, pstmt, rs);
		}

		return result;

	}

	public String getIndicadorDML(boolean isRepactuacao) {

		StringBuilder sb = new StringBuilder();

		sb.append("SELECT ");
		sb.append("  ti.nu_tipo_indicador, ");
		sb.append("  ti.no_tipo_indicador, ");
		sb.append("  ti.sg_tipo_indicador, ");
		sb.append("  vie.vr_calculo_indicador, ");
		sb.append("  vie.dh_geracao_indicador_equipe, ");
		sb.append("  coalesce(vie.vr_faixa_fns, cast(1 as numeric)) vr_faixa_fns ");
		sb.append("FROM ");
		sb.append("  gct.gcttb172_valor_indicador_equipe vie ");
		sb.append("  inner join gct.gcttb087_equipe e on e.nu_equipe = vie.nu_equipe ");
		sb.append("  INNER JOIN gct.gcttb033_grupo_contrato gc ON ( ");
		sb.append("    gc.nu_contrato = vie.nu_contrato ");
		sb.append("    AND gc.nu_tipo_grupo = vie.nu_tipo_grupo ");
		sb.append("  ) ");
		sb.append("  INNER JOIN gct.gcttb115_grupo_indicador gi ON ( ");
		sb.append("    gi.nu_contrato = vie.nu_contrato ");
		sb.append("    AND gi.nu_tipo_grupo = vie.nu_tipo_grupo ");
		sb.append("    AND gi.nu_tipo_indicador = vie.nu_tipo_indicador ");
		sb.append("  ) ");
		sb.append("  INNER JOIN gct.gcttb112_tipo_indicador ti ON ti.nu_tipo_indicador = vie.nu_tipo_indicador ");
		sb.append("WHERE ");
		sb.append("  gi.ic_aplica_indicador = 'S' ");
		sb.append("  AND e.co_equipe = ? ");
		if (isRepactuacao) {
			sb.append("  AND ( ");
			sb.append("    nu_fatura_ajuste = ? ");
			sb.append("    OR nu_fatura = ? ");
			sb.append("  ) ");
		}else {
			sb.append("  AND nu_fatura = ? ");
		}
		sb.append("ORDER BY ");
		sb.append("  vie.nu_valor_indicador DESC ");
		sb.append("LIMIT ");
		sb.append("  1; ");

		return sb.toString();
	}
